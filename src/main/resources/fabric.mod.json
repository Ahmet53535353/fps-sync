{
	"schemaVersion": 1,
	"id": "fps-sync",
	"version": "${version}",
	"name": "FPS-Sync",
	"description": "Limits FPS to the monitor's refresh rate without V-Sync. Optional: also adds an FPS Sync entry to Sodium's video settings when Sodium is installed.",
	"authors": [
		"Pasi"
	],
	"license": "LGPL-3.0",
	"icon": "assets/fps-sync/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.fpssync.FpsSyncMod"]
	},
	"mixins": [
		"fps-sync.mixins.json",
		"fps-sync.sodium.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"sodium": "*"
	}
}